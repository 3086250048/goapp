# 复制到项目根目录 .env 后填写；不要提交真实密钥。
COMPOSE_PROJECT_NAME=goapp
APP_PORT=18080
DOMAIN=trip.example.com
PUBLIC_BASE_URL=https://trip.example.com
COOKIE_SECURE=1
DEMO_MODE=0
DEMO_OTP=123456

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

SMS_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

AMAP_WEB_SERVICE_KEY=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=https://trip.example.com/api/auth/oauth/wechat/callback

QQ_APP_ID=
QQ_APP_SECRET=
QQ_REDIRECT_URI=https://trip.example.com/api/auth/oauth/qq/callback
