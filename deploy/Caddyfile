# 出行 App · Caddy 反向代理（自动 HTTPS）
# 1. 把 trip.example.com 改成你的域名
# 2. 确认应用已监听 127.0.0.1:18080
# 3. sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

trip.example.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:18080

	# 如需内测口令，取消注释并替换 caddy hash-password 的输出
	# basic_auth {
	# 	demo $2a$14$REPLACE_WITH_HASH
	# }
}
